# ─────────────────────────────────────────────────────────────
# Open Coach — variables de entorno (copiar a .env y rellenar)
# ─────────────────────────────────────────────────────────────

# Supabase — públicas (seguras en cliente). "publishable key" = nuevo formato (sustituye a la anon key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — server-only (NUNCA exponer al cliente). "secret key" = nuevo formato (sustituye a service_role)
SUPABASE_SECRET_KEY=

# Solo para el CLI (supabase db push). NO la subas al repo.
# SUPABASE_DB_PASSWORD=

# Fase 2 — Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Fase 3 — Analytics (PostHog, free tier)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_POSTHOG_KEY=
